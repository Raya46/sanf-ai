{
	"main": ".open-next/worker.js",
	"name": "sanf-ai",
	"minify": true,
	"compatibility_flags": [
		"nodejs_compat"
	],
	"compatibility_date": "2024-09-23",
	"account_id": "3f9b5eb4116447a7109cacef6de4320e",
	"vectorize": [
		{
			"binding": "VECTOR_INDEX",
			"index_name": "sanf-vector-v1"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"ai": {
		"binding": "AI"
	},
	"r2_buckets": [
		{
			"binding": "R2",
			"bucket_name": "sanf"
		}
	],
	"observability": {
		"logs": {
			"enabled": true
		}
	},
	"vars": {
		"NODE_ENV": "production",
		"CLOUDFLARE_WORKERS": "true",
		"AUTORAG_NAME": "sanf-vector-v1"
	},
	"define": {
		"globalThis.AI": "AI",
		"process.env.AI": "AI",
		"process.env.NODE_ENV": "\"production\""
	}
}