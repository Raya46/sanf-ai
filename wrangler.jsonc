{
  "main": ".open-next/worker.js",
  "name": "sanf-ai",
  "minify": true,
  "compatibility_flags": ["nodejs_compat"],
  "compatibility_date": "2024-09-23",
  "account_id":"3f9b5eb4116447a7109cacef6de4320e",
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "logs": {
      "enabled": true
    }
  },
  "vars": {
    "NODE_ENV": "production",
    "CLOUDFLARE_WORKERS": "true",
    "AUTORAG_NAME": "sanf-credit-analysis-v2"
  },
  "define": {
    "globalThis.AI": "AI",
    "process.env.AI": "AI",
    "process.env.NODE_ENV": "\"production\""
  }
}
